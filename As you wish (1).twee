:: prol_sc06_bar_lurk_barcounter {"position":"1950,6400","size":"100,100"}
''429.997.M41.03:00 STT''<br><br>
<<nobr>>
/* Инициализируем переменную для ввода имени */
<<if not _inputFakeName>><<set _inputFakeName to "">><</if>>

//Как только я подошёл к стойке, сразу почувствовал знакомый взгляд.//<br>
— А ты не любишь работать... Тебе точно нужна подработка? Как тебя зовут?<br><br>

//От её взгляда дрожь пробежала по всему телу. Не может обычная девица заставить дрожать опытного дознавателя... Подумаю об этом потом, сейчас нужно что-то придумать. Чьё имя взять? Начальника? Соседа? Или просто соврать?//<br><br>

<div style="margin: 15px 0;">
	— Я 
	<<textbox "_inputFakeName" "">> 
	
	<<button "Назваться">>
		/* Проверяем, что поле не пустое */
		<<if _inputFakeName.trim() neq "">>
			<<set _nameRaw = _inputFakeName.trim()>>
			<<set _nameLower = _nameRaw.toLowerCase()>>
			
			/* Проверки на тарабарщину через JS */
			<<set _hasVowels = /[аеёиоуыэюя]/i.test(_nameRaw)>>
			<<set _tooManyConsonants = /[бвгджзклмнпрстфхцчшщ]{4,}/i.test(_nameRaw)>>
			
			/* Новые проверки: */
			/* 1. Повторение одной буквы больше 3 раз подряд (например, "оооо", "аааа") */
			<<set _repeatedChar = /(.)\1{3,}/i.test(_nameRaw)>>
			
			/* 2. Зацикленное чередование слогов (например, "авававав", "ываыва") */
			<<set _repeatingPattern = /^(.{1,3})\1{2,}$/i.test(_nameRaw)>>
			
			/* 3. Слишком много гласных подряд (например, "оооааа") */
			<<set _tooManyVowels = /[аеёиоуыэюя]{4,}/i.test(_nameRaw)>>
			
			<<if _nameLower eq "аластор">>
				<<set $stats.perception = Math.max(0, $stats.perception - 1)>>
				<<set $stats.composure = Math.max(0, $stats.composure - 1)>>
				<<goto "prol_sc06_bar_lurk_barcounter_Alstorname">>
			<<elseif _nameLower eq "юлий">>
				<<set $stats.composure += 1>>
				<<goto "prol_sc06_bar_lurk_barcounter_Juliusname">>
			<<elseif not _hasVowels or _tooManyConsonants or _repeatedChar or _repeatingPattern or _tooManyVowels or _nameRaw.length < 2>>
				/* Вся тарабарщина (ававава, ооооо, ывпвып и т.д.) уходит сюда */
				<<goto "prol_sc06_bar_lurk_barcounter_Fakename">>
			<<else>>
				/* Любое нормальное имя */
				<<goto "prol_sc06_bar_lurk_barcounter_listen">>
			<</if>>
		<</if>>
	<</button>>
</div>
<</nobr>>


