:: prol_sc07_conclusion {"position":"4525,8475","size":"100,100"}
<<nobr>>
/* 1. Подготавливаем массивы вариантов для каждого выпадающего списка */

/* Вопрос 1А: Источник */
<<set _opt_entry_source = {
	"": "none",
	"вошёл через парадную дверь": "wrong",
	"залез через разбитое окно": "wrong"
}>>
<<if $clues.clue_1>>
	<<set _opt_entry_source["залез сверху через сломанную трубу"] = "pipe">>
<</if>>

/* Вопрос 1Б: Стена */
<<set _opt_entry_wall = {
	"": "none",
	"крался по коридору": "wrong",
	"затаился в комнате": "wrong"
}>>
<<if $clues.clue_2>>
	<<set _opt_entry_wall["спустился по стене"] = "dirty_wall">>
<</if>>

/* Вопрос 2А: Следы */
<<set _opt_path_tracks = {
	"": "none",
	"затаился у входа": "wrong",
	"постучал в дверь": "wrong"
}>>
<<if $clues.clue_3>>
	<<set _opt_path_tracks["вошёл в соседнюю комнату"] = "tracks">>
<</if>>

/* Вопрос 2Б: Вентиляция */
<<set _opt_path_vent = {
	"": "none",
	"пробил деревянную перегородку": "wrong",
	"взломал дверь": "wrong"
}>>
<<if $clues.clue_4>>
	<<set _opt_path_vent["пролез через вентиляционное отверстие"] = "vent">>
<</if>>

/* Вопрос 3: Вывод */
<<set _opt_outcome = {
	"": "none",
	"скрылся через крышу": "wrong",
	"скрылся через окно": "wrong",
	"не покидал комнату": "hiding"
}>>

//Закрыв глаза, я пытаюсь восстановить картину произошедшего. Факты должны сложиться воедино...//<br><br>

<div style="padding-left: 12px; border-left: 2px solid #555; margin-bottom: 24px;">
  //1. Как убийца проник в здание?//<br><br>
  <span style="display: inline-block;">
    <<listbox "$q_entry_source">>
    	<<optionsfrom _opt_entry_source>>
    <</listbox>>
  </span>
  &nbsp;<strong>и</strong>&nbsp;
  <span style="display: inline-block;">
    <<listbox "$q_entry_wall">>
    	<<optionsfrom _opt_entry_wall>>
    <</listbox>>
  </span>
</div>

<div style="padding-left: 12px; border-left: 2px solid #555; margin-bottom: 24px;">
  //2. Как он добрался до жертвы?//<br><br>
  <span style="display: inline-block;">
    <<listbox "$q_path_tracks">>
    	<<optionsfrom _opt_path_tracks>>
    <</listbox>>
  </span>
  &nbsp;<strong>и</strong>&nbsp;
  <span style="display: inline-block;">
    <<listbox "$q_path_vent">>
    	<<optionsfrom _opt_path_vent>>
    <</listbox>>
  </span>
</div>

<div style="padding-left: 12px; border-left: 2px solid #555; margin-bottom: 24px;">
  //3. Где он сейчас?//<br><br>
  <span style="display: inline-block;">
    <<listbox "$q_outcome">>
    	<<optionsfrom _opt_outcome>>
    <</listbox>>
  </span>
</div>

[[Сложить картину воедино|prol_sc07_check_conclusion]]<br>
[[Вернуться к осмотру|prol_sc07_inspection_cluehub]]
<</nobr>>


