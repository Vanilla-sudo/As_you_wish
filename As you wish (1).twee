:: ch_1_start {"position":"3675,9575","size":"100,100"}
<<nobr>>
Спасибо за прохождение пролога «As you wish».<br><br>

В следующих главах будет рассказана история гибели мира Корделис глазами Марка и Валерии.<br><br>

В следующих главах будут добавлены механики:<br>
— связей в личном планшете;<br>
— слежки;<br>
— заражения;<br>
— стресса;<br>
— аугментации.<br><br>

Будут добавлены новые локации, второстепенные персонажи, раскрытие уже встреченных персонажей.<br><br>

Героям предстоит разгадать ещё больше загадок и принимать всё более сложные решения на пути к трагическому финалу.<br><br>

В прологе осталось немало скрытых деталей, вариативных сцен и диалогов, которые вы могли пропустить. Вы всегда можете переиграть его, чтобы попробовать другие решения и узнать больше секретов.<br><br>

<<link "Выбрать иной путь">>
  <<script>>Engine.restart();<</script>>
<</link>>
<</nobr>>



:: prol_checkstats {"position":"3675,9425","size":"100,100"}
/* --- 1. Расчет психологического профиля --- */
<<set _traits = []>>
<<if $stats.aggression >= 3>>
  <<run _traits.push("склонен к неконтролируемой агрессии и превышению полномочий")>>
<</if>>
<<if $stats.composure >= 3>>
  <<run _traits.push("демонстрирует холодный расчёт, высокую стрессоустойчивость и прагматизм")>>
<</if>>
<<if $stats.influence >= 3>>
  <<run _traits.push("склонен к социальной манипуляции и задействованию неформального влияния")>>
<</if>>
<<if $stats.perception >= 3>>
  <<run _traits.push("обладает высокой дедуктивной наблюдательностью и повышенным вниманием к деталям")>>
<</if>>

<<if _traits.length > 0>>
  <<set $psych_profile = _traits.join("; ") + "." >>
<<else>>
  <<set $psych_profile = "Усреднённые показатели без явно выраженных доминирующих черт. Признаки психоэмоционального выгорания.">>
<</if>>

/* --- 2. Расчет вердиктов --- */
<<if $stats.aggression <= 1>>
  <<set _verdict_aggression = "не проявляет признаков излишней агрессии">>
<<elseif $stats.aggression == 2>>
  <<set _verdict_aggression = "допускает использование жестких и силовых методов при исполнении служебных обязанностей">>
<<else>>
  <<set _verdict_aggression = "склонен к проявлению чрезмерной агрессии, представляет угрозу дисциплине и порядку">>
<</if>>

<<if $stats.perception <= 1>>
  <<set _verdict_perception = "способности к анализу оперативной обстановки и вычленению деталей слабо выражены">>
<<elseif $stats.perception == 2>>
  <<set _verdict_perception = "проявляет должную осмотрительность, способен фиксировать ключевые детали обстановки">>
<<else>>
  <<set _verdict_perception = "обладает высоким уровнем аналитического мышления, фиксирует скрытые связи и детали">>
<</if>>

<<if $stats.composure <= 1>>
  <<set _verdict_composure = "в стрессовых ситуациях склонен к стороннему давлению">>
<<elseif $stats.composure == 2>>
  <<set _verdict_composure = "демонстрирует эмоциональную устойчивость и самоконтроль в нестандартных ситуациях">>
<<else>>
  <<set _verdict_composure = "обладает высокой стрессоустойчивостью, внешним раздражителям не подвержен">>
<</if>>

<<if $stats.influence <= 1>>
  <<set _verdict_influence = "навыки психоэмоционального воздействия и убеждения не продемонстрированы">>
<<elseif $stats.influence == 2>>
  <<set _verdict_influence = "практикует методы косвенного давления, включая манипулятивные техники и служебный ресурс">>
<<else>>
  <<set _verdict_influence = "в совершенстве владеет приемами психологического воздействия и скрытого манипулирования">>
<</if>>

<<if $stats.respect_street == 0>>
  <<set _verdict_street = "постоянные оперативные контакты среди местного населения и в криминальной среде отсутствуют">>
<<else>>
  <<set _verdict_street = "располагает установившимся авторитетом и доверием среди местного населения">>
<</if>>

<<if $stats.respect_colleagues == 0>>
  <<set _verdict_colleagues = "в неформальном взаимодействии с личным составом не состоит, держится обособленно">>
<<else>>
  <<set _verdict_colleagues = "пользуется установившимся авторитетом среди сотрудников смежных и силовых ведомств">>
<</if>>

<<if $stats.trust >= 1>>
  <<set _verdict_trust = "поддается рациональному убеждению и стороннему руководству">>
<<else>>
  <<set _verdict_trust = "не поддается внутреннему контролю, склонен к нарушению субординации">>
<</if>>

<<set $auditor_verdict = "За время наблюдения было обнаружено, что объект наблюдения следователь Марк Витус " + 
  _verdict_aggression + "; " + 
  _verdict_perception + "; " + 
  _verdict_composure + "; " + 
  _verdict_influence + "; " + 
  _verdict_street + "; " + 
  _verdict_colleagues + "; " + 
  _verdict_trust + "." >>

/* --- 3. Отрисовка отчета через JS-макрос --- */
<<auditReport>>


