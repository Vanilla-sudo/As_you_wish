:: Журнал рабочий {"position":"4800,150","size":"100,100"}
<style>
  #journal-root a {
    color: #2ecc71 !important;
    text-decoration: none;
  }
  #journal-root a:hover {
    color: #a9dfbf !important;
  }
  .vox-btn-container button {
    background: #002200;
    color: #2ecc71;
    border: 1px solid #2ecc71;
    padding: 6px 12px;
    font-family: monospace;
    font-weight: bold;
    cursor: pointer;
    width: 100%;
    text-align: center;
    transition: background 0.2s, color 0.2s;
  }
  .vox-btn-container button:hover {
    background: #1e8449;
    color: #ffffff;
  }
</style>

<div id="journal-root" style="font-family: monospace; color: #2ecc71; padding: 0px; font-size: 1em; line-height: 1.2;">

<!-- ВЕРХНЯЯ НАВИГАЦИОННАЯ ПАНЕЛЬ -->
<div style="border-bottom: 2px solid #2ecc71; padding-bottom: 4px; margin-bottom: 6px; display: flex; gap: 12px; font-weight: bold; font-size: 0.9em;">
  <<link "[ Контакты ]">>
    <<set _journalTab = "informants">>
    <<set _selectedInformantId = null>>
    <<set _selectedClueId = null>>
    <<set _selectedNoteId = null>>
    <<replace "#journal-root">><<include "Journal_UI">><</replace>>
  <</link>>

  <<link "[ Улики ]">>
    <<set _journalTab = "clues">>
    <<set _selectedInformantId = null>>
    <<set _selectedClueId = null>>
    <<set _selectedNoteId = null>>
    <<replace "#journal-root">><<include "Journal_UI">><</replace>>
  <</link>>

  <<link "[ Заметки ]">>
    <<set _journalTab = "notes">>
    <<set _selectedInformantId = null>>
    <<set _selectedClueId = null>>
    <<set _selectedNoteId = null>>
    <<replace "#journal-root">><<include "Journal_UI">><</replace>>
  <</link>>
</div>

<!-- ================= 1. ВКЛАДКА: КОНТАКТЫ ================= -->
<<if _journalTab eq "informants" or not _journalTab>>

  <<if _selectedInformantId>>
    <<nobr>>
    <<set _inf = $journal.informants.find(i => i.id === _selectedInformantId)>>
    
    <div style="margin-bottom: 6px; margin-top: 0px;">
      <<link "[ < Назад к списку ]">>
        <<set _selectedInformantId = null>>
        <<replace "#journal-root">><<include "Journal_UI">><</replace>>
      <</link>>
    </div>

    <<if _inf>>
    <div style="border: 1px solid #2ecc71; background: rgba(0, 30, 0, 0.4); padding: 8px; font-size: 0.95em;">
      <div style="color: #2ecc71; font-size: 1.15em; font-weight: bold; margin-bottom: 6px;">_inf.name</div>
      
      <div style="margin-bottom: 8px; color: #a9dfbf; border-left: 2px solid #2ecc71; padding-left: 6px;">
        _inf.desc
      </div>

      <div style="color: #2ecc71; font-size: 0.85em; font-weight: bold; border-bottom: 1px dashed #27ae60; padding-bottom: 2px; margin-bottom: 4px;">
        ЗАФИКСИРОВАННЫЕ ФАКТЫ:
      </div>

      <<if _inf.notes and _inf.notes.length gt 0>>
        <<for _n = 0; _n < _inf.notes.length; _n++>>
          <div style="font-size: 0.85em; color: #2ecc71; margin-bottom: 2px;">
            - _inf.notes[_n]
          </div>
        <</for>>
      <<else>>
        <div style="color: #27ae60; font-style: italic; font-size: 0.85em;">Записи отсутствуют.</div>
      <</if>>

      <!-- ИНТЕРАКТИВНЫЙ БЛОК ВОКС-ВЫЗОВА (ДЛЯ ЮЛИЯ КРАССА) -->
      <<if _inf.id === "krass" or _inf.id === "yuliy" or _inf.name.includes("Юлий")>>
        <div style="margin-top: 12px; border-top: 1px solid #2ecc71; padding-top: 8px;">
          <div style="color: #f1c40f; font-weight: bold; font-size: 0.8em; margin-bottom: 4px;">
            [ ПРЯМАЯ ВОКС-ЛИНИЯ ]
          </div>
          <div class="vox-btn-container">
            <<button " [ ИНИЦИИРОВАТЬ ВОКС-ВЫЗОВ ] ">>
              <<run Dialog.close()>>
              <<if passage() eq "prol_sc06_bar_secur_nosuit">>
                <<goto "prol_sc06_bar_entry_check_trust">>
              <<else>>
                <<goto "VoxCall_Krass_Idle">>
              <</if>>
            <</button>>
          </div>
        </div>
      <</if>>

    </div>
    <</if>>
    <</nobr>>

  <<else>>
    <<nobr>>
    <<set _unlockedCount = 0>>
    <div style="display: flex; flex-direction: column; gap: 2px;">
    <<for _i = 0; _i < $journal.informants.length; _i++>>
      <<if $journal.informants[_i].unlocked>>
        <<set _unlockedCount++>>
        <<capture _i>>
          <div style="border-bottom: 1px dashed #1e8449; padding: 3px 0; margin: 0;">
            <<link "$journal.informants[_i].name">>
              <<set _selectedInformantId = $journal.informants[_i].id>>
              <<replace "#journal-root">><<include "Journal_UI">><</replace>>
            <</link>>
          </div>
        <</capture>>
      <</if>>
    <</for>>
    </div>

    <<if _unlockedCount eq 0>>
      <div style="color: #27ae60; font-style: italic; font-size: 0.9em; text-align: center; margin-top: 5px;">
        База данных пуста.
      </div>
    <</if>>
    <</nobr>>
  <</if>>

<!-- ================= 2. ВКЛАДКА: УЛИКИ ================= -->
<<elseif _journalTab eq "clues">>

  <<if _selectedClueId neq null>>
    <<nobr>>
    <<set _clue = $journal.clues[_selectedClueId]>>
    <<set _clueName = typeof _clue === 'object' ? _clue.name : _clue>>
    <<set _clueDesc = typeof _clue === 'object' ? _clue.desc : "Подробное описание отсутствует.">>
    
    <div style="margin-bottom: 6px; margin-top: 0px;">
      <<link "[ < Назад к списку улик ]">>
        <<set _selectedClueId = null>>
        <<replace "#journal-root">><<include "Journal_UI">><</replace>>
      <</link>>
    </div>

    <div style="border: 1px solid #2ecc71; background: rgba(0, 30, 0, 0.4); padding: 8px; font-size: 0.95em;">
      <div style="color: #2ecc71; font-size: 1.15em; font-weight: bold; margin-bottom: 6px;">_clueName</div>
      
      <div style="color: #a9dfbf; border-left: 2px solid #2ecc71; padding-left: 6px;">
        _clueDesc
      </div>
    </div>
    <</nobr>>

  <<else>>
    <<nobr>>
    <<set _cluesCount = $journal.clues.length>>
    <div style="display: flex; flex-direction: column; gap: 2px;">
    <<for _c = 0; _c < $journal.clues.length; _c++>>
      <<capture _c>>
        <<set _cItem = $journal.clues[_c]>>
        <<set _cName = typeof _cItem === 'object' ? _cItem.name : _cItem>>
        <div style="border-bottom: 1px dashed #1e8449; padding: 3px 0; margin: 0;">
          <<link _cName>>
            <<set _selectedClueId = _c>>
            <<replace "#journal-root">><<include "Journal_UI">><</replace>>
          <</link>>
        </div>
      <</capture>>
    <</for>>
    </div>

    <<if _cluesCount eq 0>>
      <div style="color: #27ae60; font-style: italic; font-size: 0.9em; text-align: center; margin-top: 5px;">
        Улики не зафиксированы.
      </div>
    <</if>>
    <</nobr>>
  <</if>>

<!-- ================= 3. ВКЛАДКА: ЗАМЕТКИ ================= -->
<<elseif _journalTab eq "notes">>

  <<if _selectedNoteId neq null>>
    <<nobr>>
    <<set _note = $journal.notes[_selectedNoteId]>>
    <<set _noteName = typeof _note === 'object' ? _note.name : _note>>
    <<set _noteDesc = typeof _note === 'object' ? _note.desc : "Текст заметки отсутствует.">>
    
    <div style="margin-bottom: 6px; margin-top: 0px;">
      <<link "[ < Назад к списку заметок ]">>
        <<set _selectedNoteId = null>>
        <<replace "#journal-root">><<include "Journal_UI">><</replace>>
      <</link>>
    </div>

    <div style="border: 1px solid #2ecc71; background: rgba(0, 30, 0, 0.4); padding: 8px; font-size: 0.95em;">
      <div style="color: #f1c40f; font-size: 1.15em; font-weight: bold; margin-bottom: 6px;">_noteName</div>
      
      <div style="color: #a9dfbf; border-left: 2px solid #f1c40f; padding-left: 6px; margin-bottom: 10px;">
        <<print _noteDesc>>
      </div>

      <!-- ВЫВОД НАКОПЛЕННЫХ ФАКТОВ ВНУТРИ ЗАМЕТКИ -->
      <div style="color: #2ecc71; font-size: 0.85em; font-weight: bold; border-bottom: 1px dashed #27ae60; padding-bottom: 2px; margin-bottom: 6px;">
        ЗАФИКСИРОВАННЫЕ ФАКТЫ:
      </div>

      <<if _note.notes and _note.notes.length gt 0>>
        <<for _i = 0; _i < _note.notes.length; _i++>>
          <div style="font-size: 0.85em; color: #2ecc71; margin-bottom: 4px;">
            • _note.notes[_i]
          </div>
        <</for>>
      <<else>>
        <div style="color: #27ae60; font-style: italic; font-size: 0.85em;">Пока ничего нового не замечено.</div>
      <</if>>

    </div>
    <</nobr>>

  <<else>>
    <<nobr>>
    <<set _notesCount = $journal.notes.length>>
    <div style="display: flex; flex-direction: column; gap: 2px;">
    <<for _n = 0; _n < $journal.notes.length; _n++>>
      <<capture _n>>
        <<set _nItem = $journal.notes[_n]>>
        <<set _nName = typeof _nItem === 'object' ? _nItem.name : _nItem>>
        <div style="border-bottom: 1px dashed #1e8449; padding: 3px 0; margin: 0;">
          <<link _nName>>
            <<set _selectedNoteId = _n>>
            <<replace "#journal-root">><<include "Journal_UI">><</replace>>
          <</link>>
        </div>
      <</capture>>
    <</for>>
    </div>

    <<if _notesCount eq 0>>
      <div style="color: #27ae60; font-style: italic; font-size: 0.9em; text-align: center; margin-top: 5px;">
        Заметки отсутствуют.
      </div>
    <</if>>
    <</nobr>>
  <</if>>

<</if>>

</div>


:: Параграф без названия {"position":"3125,4600","size":"100,100"}
<<nobr>>
<<set $searched_table = true>>
<<set $velina_known = true>>
<<set $clues.red_dress = true>>
<<set $clues.clue_1 = true>>

/* Инициализация переменной для ввода */
<<set _passInput = "">>

<div id="pad-intro">
	//Незарегистрированный планшет? Серьёзный подход. Экран заблокирован паролем.//<br><br>
</div>

<!-- ЭКРАН ПЛАНШЕТА -->
<div id="pad-box" class="pad-container" style="border: 1px solid #1e8449; background: rgba(11, 31, 20, 0.85); padding: 18px; border-radius: 4px; box-shadow: 0 0 15px rgba(30, 132, 73, 0.2); font-family: monospace; transition: all 0.5s ease; min-height: 50px;">

	<div id="pad-screen">
		<div style="color: #f1c40f; margin-bottom: 10px;">
			ВВЕДИТЕ ПИН-КОД ИЛИ ПАРОЛЬ ДОСТУПА:
		</div>
		<<textbox "_passInput" "">> 
		<span id="pad-btn-style">
			<<button "РАЗБЛОКИРОВАТЬ">>
				<<if _passInput.trim().toUpperCase() eq "V4E9L7">>
					/* Стираем вступительную фразу над планшетом */
					<<replace "#pad-intro">><</replace>>

					<<replace "#pad-screen">>
						<div style="color: #f1c40f; font-style: italic; background: rgba(0,0,0,0.3); padding: 10px; border-left: 3px solid #f1c40f;">
							«Сегодня я снова видел тебя во сне! Жду нашей следующей встречи, хочу снова утонуть в твоих ярких голубых глазах. Чувствовать твоё дыхание...»
						</div>
					<</replace>>
					<<replace "#hero-thought">>
						//Да ты чёртов романтик! Только вот о жене своей ты не подумал, да? Нужно найти что-нибудь по делу...//
					<</replace>>
					<<replace "#pad-controls">>
						<span class="green-pad-btn">
							<<button "Следующее сообщение">>
								<<replace "#pad-screen">>
									<div style="color: #f1c40f; font-style: italic; background: rgba(0,0,0,0.3); padding: 10px; border-left: 3px solid #f1c40f;">
										«По поводу проектов: планы нижних уровней достать немного сложнее, чем выбить место для "Рассветной верфи". Надеюсь, смогу увидеть тебя в том красном платье, которое я тебе выслал, оно так подходит к твоим светлым волосам...»
									</div>
								<</replace>>
								<<replace "#hero-thought">>
										//Пользуешься служебным положением, чтобы удовлетворять прихоти своей «принцессы». Типичная схема: только раньше они сорили деньгами, а не участками и чертежами.//
								<</replace>>
								<<replace "#pad-controls">>
									<span class="green-pad-btn">
										<<button "Следующее сообщение">>
											<<replace "#pad-screen">>
												<div style="color: #f1c40f; font-style: italic; background: rgba(0,0,0,0.3); padding: 10px; border-left: 3px solid #f1c40f;">
													«Велина, сегодня я добыл необходимые планы, но у меня плохая новость: мне написал шантажист...»
												</div>
											<</replace>>
											<<replace "#hero-thought">>
											<</replace>>
											<<replace "#pad-controls">>
												<span class="green-pad-btn">
													<<button "Следующее сообщение">>
														/* ЭФФЕКТ ВЫКЛЮЧЕНИЯ ПЛАНШЕТА (ПОЛНОЕ ГАШЕНИЕ) */
														<<run jQuery('#pad-box').css({
															'border-color': '#111111',
															'background': '#050505',
															'box-shadow': 'none'
														})>>
														<<replace "#pad-screen">><</replace>>
														<<replace "#pad-controls">><</replace>>
														<<run jQuery('#pad-final-sequence').show()>>
													<</button>>
												</span>
											<</replace>>
										<</button>>
									</span>
								<</replace>>
							<</button>>
						</span>
					<</replace>>
				<<else>>
					/* Обратная связь при неверном пароле */
					<<replace "#pad-error" t8n>>
						<span style="color: #e74c3c; font-size: 0.9em; display: block; margin-top: 5px;">//Неверный пароль. Доступ заблокирован.//</span>
					<</replace>>
				<</if>>
			<</button>>
		</span>
		<div id="pad-error"></div>
	</div>
</div>

<!-- МЫСЛИ И КНОПКИ СТРОГО ВНЕ ПЛАНШЕТА -->
<br>
<div id="hero-thought"></div>
<br>

<div id="pad-controls" style="margin-top: 10px;">
	<!-- ЗАЩИТА ОТ СОФТЛОКА: Ссылка на возвращение в комнату, если игрок не знает пароль -->
	[[Вернуться к осмотру комнаты|prol_sc05_Israel_hotel]]
</div>

<div id="pad-final-sequence" style="display: none;">
	//Чёрт! Планшет сел. Услышав шаги за дверью, я вылез в окно — точно так же, как и попал сюда.//<br><br>

	[[Занятная девушка...|prol_sc05_informantshub]]
</div>
<</nobr>>


:: панель рабочая {"position":"4925,150","size":"100,100"}
/* 1. КНОПКА ОТКРЫТИЯ ИНФОПЛАНШЕТА */
<<if $has_holopad>>
  <div style="margin-bottom: 15px;">
    <div class="red-terminal-btn">
      <<button " Инфопланшет ">>
        /* Открываем диалог */
        <<run Dialog.setup("ИНФОПЛАНШЕТ ENFORCER-HRXZ/8856945")>>
        <<set _journalTab = "informants">>
        <<set _selectedInformantId = null>>
        <<run Dialog.wiki('<<include "Journal_UI">>')>>
        <<run Dialog.open()>>

        /* Обновляем блок контактов в пассаже */
        <<replace "#contacts">>
          <div style="margin-top: 10px;">
            [[Аластор|prol_sc05_Alastor]] <br>
            [[Виктор|prol_sc05_Victor]] <br>
            [[Исраэль|prol_sc05_Israel]] <br>
            [[Ордо|prol_sc05_Ordo]] <br>
          </div>
        <</replace>>
      <</button>>
    </div>
  </div>
<</if>>

/* 2. БЛОК ХАРАКТЕРИСТИК И ИНВЕНТАРЯ */
<div class="stats-panel" style="margin-top: 0px; padding-top: 5px;">
  <div class="stats-header" style="margin-top: 0px;"> ХАРАКТЕРИСТИКИ</div>
  Агрессия: $stats.aggression<br>
  Хладнокровие: $stats.composure<br>
  Влияние: $stats.influence<br>
  Восприятие: $stats.perception<br>
  Коррупция: $stats.corruption<br>

  <div class="stats-header"> РЕПУТАЦИЯ</div>
  Улица: $stats.respect_street | Коллеги: $stats.respect_colleagues<br>
  Доверие: $stats.trust<br>

  <div class="stats-header"> ИНВЕНТАРЬ И СОСТОЯНИЕ</div>
  Деньги: $money<br>
  <<if $has_wallet>>• Кошелёк<br><</if>>\
  <<if $has_suit>>• Костюм<br><</if>>\
  <<if $has_pass>>• Пропуск<br><</if>>\
  <<if $has_vip_pass>>• VIP-пропуск<br><</if>>\
  <<if $has_key>>• Ключ<br><</if>>\
  <<if $has_capsules>>• Капсулы<br><</if>>\
  <<if $has_photo_burnt>>• Обгоревшее фото<br><</if>>\
  <<if $has_photo_full>>• Целое фото<br><</if>>\
</div>


:: стили рабочие {"position":"5075,150","size":"100,100"}
@keyframes termFlicker {
  0% { opacity: 0.95; }
  50% { opacity: 1; }
  52% { opacity: 0.82; }
  54% { opacity: 1; }
  80% { opacity: 0.92; }
  90% { opacity: 0.88; }
  100% { opacity: 0.96; }
}

.terminal-box-animated {
  background: #050505;
  border: 1px solid #1e8449;
  padding: 20px;
  font-family: monospace, sans-serif;
  color: #2ecc71;
  box-shadow: inset 0 0 15px rgba(46, 204, 113, 0.1);
  animation: termFlicker 0.15s infinite;
  max-height: 75vh;
  overflow-y: auto;
  box-sizing: border-box;
}

/* Общие стили для кнопок в обоих терминалах */
#terminal-link-container button, 
#audit-terminal-link-container button {
  background-color: #0b1f14;
  color: #2ecc71;
  border: 1px solid #2ecc71;
  padding: 10px 20px;
  font-family: monospace, sans-serif;
  font-weight: bold;
  cursor: pointer;
  box-shadow: 0 0 10px rgba(46, 204, 113, 0.2);
  transition: all 0.2s ease;
}

#terminal-link-container button:hover, 
#audit-terminal-link-container button:hover {
  background-color: #1e8449;
  color: #ffffff;
  box-shadow: 0 0 15px rgba(46, 204, 113, 0.6);
}

/* Поднимаем вверх пассаж с отчетом */
div[data-passage="prol_checkstats"] {
  margin-top: -1200px !important;
}

/* Стили для кнопки вокс-канала / ТВ */
#tv-link-container button {
  background-color: #1f0b0b;
  color: #e74c3c;
  border: 1px solid #e74c3c;
  padding: 10px 20px;
  font-family: monospace, sans-serif;
  font-weight: bold;
  cursor: pointer;
  box-shadow: 0 0 10px rgba(231, 76, 60, 0.2);
  transition: all 0.2s ease;
}

#tv-link-container button:hover {
  background-color: #e74c3c;
  color: #ffffff;
  box-shadow: 0 0 15px rgba(231, 76, 60, 0.6);
}

/* Стили для кнопок на ТВ-экране */
#tv-links-container button {
  background-color: #1f0b0b;
  color: #e74c3c;
  border: 1px solid #e74c3c;
  padding: 10px 20px;
  font-family: monospace, sans-serif;
  font-weight: bold;
  cursor: pointer;
  box-shadow: 0 0 10px rgba(231, 76, 60, 0.2);
  transition: all 0.2s ease;
}

#tv-links-container button:hover {
  background-color: #e74c3c;
  color: #ffffff;
  box-shadow: 0 0 15px rgba(231, 76, 60, 0.6);
}

/* Объемный / выпуклый ЭЛТ-экран */
.terminal-box-convex {
  background: radial-gradient(circle at center, #0d1a12 0%, #030805 100%);
  border: 2px solid #27ae60;
  padding: 25px;
  font-family: monospace, sans-serif;
  color: #2ecc71;
  /* Иллюзия выпуклости: яркий блик сверху-изнутри и глубокая тень снаружи */
  box-shadow: 
    inset 0 15px 25px rgba(46, 204, 113, 0.15), 
    inset 0 -15px 25px rgba(0, 0, 0, 0.8),
    0 5px 20px rgba(0, 0, 0, 0.8),
    0 0 15px rgba(46, 204, 113, 0.1);
  animation: termFlicker 0.15s infinite;
  max-height: 75vh;
  overflow-y: auto;
  box-sizing: border-box;
  position: relative;
}

/* То же самое для телевизионного вокс-канала (с красным оттенком) */
.tv-box-convex {
  background: radial-gradient(circle at center, #1a0d0d ilə, #080303 100%);
  border: 2px solid #e74c3c;
  padding: 25px;
  font-family: monospace, sans-serif;
  color: #f1c40f;
  box-shadow: 
    inset 0 15px 25px rgba(231, 76, 60, 0.15), 
    inset 0 -15px 25px rgba(0, 0, 0, 0.8),
    0 5px 20px rgba(0, 0, 0, 0.8),
    0 0 15px rgba(231, 76, 60, 0.1);
  animation: termFlicker 0.15s infinite;
  max-height: 75vh;
  overflow-y: auto;
  box-sizing: border-box;
  position: relative;
}

/* Стиль для кнопки внутри терминала */
.terminal-link-container button {
  background-color: transparent !important;
  border: 1px solid #1e8449 !important;
  color: #2ecc71 !important;
  font-family: monospace, sans-serif !important;
  font-size: 13px !important;
  letter-spacing: 1px !important;
  padding: 10px 20px !important;
  text-transform: uppercase !important;
  cursor: pointer !important;
  transition: all 0.2s ease-in-out !important;
  border-radius: 0px !important;
}

/* Эффект при наведении курсора */
.terminal-link-container button:hover {
  background-color: rgba(30, 132, 73, 0.25) !important;
  border-color: #2ecc71 !important;
  color: #2ecc71 !important;
  box-shadow: 0 0 10px rgba(46, 204, 113, 0.5) !important;
}

/* 1. Базовое оформление текста в обычных сценах */
.passage {
  font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  font-size: 1.05em;
  line-height: 1.7;
  color: #d1d5db; /* Мягкий светло-серый цвет для комфортного чтения */
}

/* 2. Оформление прямой речи / реплик */
.speech {
  border-left: 3px solid #4a5568; /* Нейтральная плашка слева */
  background: rgba(255, 255, 255, 0.03);
  padding: 8px 14px;
  margin: 10px 0;
  border-radius: 0 4px 4px 0;
}

/* 3. Оформление мыслей персонажа (курсив) */
.thoughts, i, em {
  color: #9ca3af;
  font-style: italic;
}

/* 4. Оформление вариантов выбора (ссылок) */
a {
  color: #60a5fa !important; /* Мягкий синий или #2ecc71 для зеленого */
  text-decoration: none !important;
  border-bottom: 1px dashed rgba(96, 165, 250, 0.4);
  transition: all 0.2s ease;
}

a:hover {
  color: #93c5fd !important;
  border-bottom-color: #93c5fd;
  text-shadow: 0 0 6px rgba(147, 197, 253, 0.4);
}

* Контейнер для сцен сна / галлюцинаций */
.dream-box {
  background: rgba(43, 27, 61, 0.35); /* Полупрозрачный фиолетовый туман */
  border-left: 3px solid #8e44ad; /* Пурпурный акцент */
  border-right: 1px solid rgba(142, 68, 173, 0.2);
  padding: 18px 22px;
  margin: 20px 0;
  border-radius: 6px;
  box-shadow: 0 0 15px rgba(142, 68, 173, 0.15); /* Мягкое свечение */
  backdrop-filter: blur(2px); /* Эффект легкого размытия фонового слоя */
}

/* Описание мыслей или видений во сне */
.dream-box em, .dream-text {
  color: #d7bde2; /* Мягкий сиренево-белый цвет */
  font-style: italic;
  letter-spacing: 0.5px;
}

/* Шепот или искаженные голоса во сне */
.dream-whisper {
  color: #a569bd;
  font-weight: bold;
  text-transform: uppercase;
  letter-spacing: 2px;
  font-size: 0.9em;
  margin-bottom: 8px;
}

/* --- ГЛОБАЛЬНАЯ АТМОСФЕРА УГРОЗЫ (Тег "danger") --- */

/* 1. Фон плавно заливается тёмно-багровым градиентом */
body[data-tags~="danger"] {
  background: radial-gradient(circle at center, #1a0505 0%, #080303 100%) !important;
  transition: background 0.8s ease-in-out;
}

/* 2. Текст момента ранения слегка светится кроваво-красным */
.pain-text {
  color: #ff6b6b;
  text-shadow: 0 0 8px rgba(255, 107, 107, 0.4);
}

/* 3. Варианты выбора становятся янтарно-опасными и слегка пульсируют */
body[data-tags~="danger"] a {
  color: #ff9f43 !important;
  border-bottom: 1px dashed rgba(255, 159, 67, 0.6) !important;
  font-weight: 500;
  transition: all 0.2s ease;
}

body[data-tags~="danger"] a:hover {
  color: #ff5252 !important;
  border-bottom-color: #ff5252 !important;
  text-shadow: 0 0 10px rgba(255, 82, 82, 0.7) !important;
}

/* --- ТЕРМИНАЛ С ШУМОМ (ВОКС-КАНАЛ) --- */
.vox-terminal {
  border: 2px solid #e74c3c;
  background-color: #080303;
  margin: 20px auto;
  max-width: 700px;
  height: 220px;
  position: relative;
  overflow: hidden;
  box-shadow: 
    inset 0 0 15px rgba(231, 76, 60, 0.2), 
    0 0 15px rgba(231, 76, 60, 0.15);
}

/* Генерация телевизионного шума */
.vox-terminal::before {
  content: "";
  position: absolute;
  top: -50%; left: -50%; right: -50%; bottom: -50%;
  background: transparent url('data:image/svg+xml;utf8,<svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg"><filter id="noiseFilter"><feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="3" stitchTiles="stitch"/></filter><rect width="100%25" height="100%25" filter="url(%23noiseFilter)" opacity="0.45"/></svg>');
  opacity: 0.7;
  animation: noise-anim 0.2s steps(4) infinite;
}

/* Сканирующие полосы */
.vox-terminal::after {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.4) 50%), 
              repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(255, 255, 255, 0.05) 3px);
  background-size: 100% 4px, 100% 100%;
  pointer-events: none;
  animation: scanline-anim 0.15s linear infinite;
}

@keyframes noise-anim {
  0% { transform: translate(0, 0); }
  25% { transform: translate(-5px, 5px); }
  50% { transform: translate(5px, -5px); }
  75% { transform: translate(-2px, -3px); }
  100% { transform: translate(3px, 2px); }
}

@keyframes scanline-anim {
  0% { opacity: 0.8; }
  50% { opacity: 0.5; }
  100% { opacity: 0.9; }
}

.text-center {
  text-align: center;
  margin-top: 15px;
}

.terminal-actions {
  text-align: center;
  margin-top: 25px;
}

/* Кнопка «Выключить» в точном стиле вашего ТВ-канала */
.terminal-actions a, 
.terminal-actions button {
  background-color: #1f0b0b !important;
  color: #e74c3c !important;
  border: 1px solid #e74c3c !important;
  padding: 10px 20px !important;
  font-family: monospace, sans-serif !important;
  font-weight: bold !important;
  font-size: 0.95em;
  letter-spacing: 1px;
  text-decoration: none !important;
  cursor: pointer !important;
  display: inline-block;
  box-shadow: 0 0 10px rgba(231, 76, 60, 0.2);
  transition: all 0.2s ease;
}

.terminal-actions a:hover, 
.terminal-actions button:hover {
  background-color: #e74c3c !important;
  color: #ffffff !important;
  box-shadow: 0 0 15px rgba(231, 76, 60, 0.6) !important;
}

/* Красная кнопка вокс-планшета */
.red-terminal-btn button {
  background-color: #78281f !important;
  color: #ff3333 !important;
  border: 1px solid #ff4d4d !important;
  width: 100%;
  font-weight: bold;
  text-transform: uppercase;
  letter-spacing: 1px;
  box-shadow: 0 0 8px rgba(255, 77, 77, 0.3);
  transition: all 0.2s ease-in-out;
}

.red-terminal-btn button:hover {
  background-color: #b03a2e !important;
  color: #ffffff !important;
  border-color: #ff6666 !important;
  box-shadow: 0 0 12px rgba(255, 77, 77, 0.7);
}




:: сторикапча рабочий {"position":"4575,150","size":"100,100"}
/* 1. КНОПКА ОТКРЫТИЯ ИНФОПЛАНШЕТА */
<<if $has_holopad>>
  <div style="margin-bottom: 15px;">
    <div class="red-terminal-btn">
      <<button " Инфопланшет ">>
        /* 1. Открываем диалоговое окно Дневника */
        <<run Dialog.setup("ИНФОПЛАНШЕТ ENFORCER-HRXZ/8856945")>>
        <<set _journalTab = "informants">>
        <<set _selectedInformantId = null>>
        <<run Dialog.wiki('<<include "Journal_UI">>')>>
        <<run Dialog.open()>>

        /* 2. Обновляем список контактов ТОЛЬКО ЕСЛИ мы на странице хаба (где есть #contacts) */
        <<if jQuery("#contacts").length gt 0>>
          <<replace "#contacts">>
            <div style="margin-top: 10px;">
              [[Аластор|prol_sc05_Alastor]] <br>
              [[Виктор|prol_sc05_Victor]] <br>
              [[Исраэль|prol_sc05_Israel]] <br>
              [[Ордо|prol_sc05_Ordo]] <br>
            </div>
          <</replace>>
        <</if>>
      <</button>>
    </div>
  </div>
<</if>>

/* 2. БЛОК ХАРАКТЕРИСТИК И ИНВЕНТАРЯ */
<div class="stats-panel" style="margin-top: 0px; padding-top: 5px;">
  <div class="stats-header" style="margin-top: 0px;"> ХАРАКТЕРИСТИКИ</div>
  Агрессия: $stats.aggression<br>
  Хладнокровие: $stats.composure<br>
  Влияние: $stats.influence<br>
  Восприятие: $stats.perception<br>
  Коррупция: $stats.corruption<br>

  <div class="stats-header"> РЕПУТАЦИЯ</div>
  Улица: $stats.respect_street | Коллеги: $stats.respect_colleagues<br>
  Доверие: $stats.trust<br>

  <div class="stats-header"> ИНВЕНТАРЬ И СОСТОЯНИЕ</div>
  Деньги: $money<br>
  <<if $has_wallet>>• Кошелёк<br><</if>>\
  <<if $has_suit>>• Костюм<br><</if>>\
  <<if $has_pass>>• Пропуск<br><</if>>\
  <<if $has_vip_pass>>• VIP-пропуск<br><</if>>\
  <<if $has_key>>• Ключ<br><</if>>\
  <<if $has_capsules>>• Капсулы<br><</if>>\
  <<if $has_photo_burnt>>• Обгоревшее фото<br><</if>>\
  <<if $has_photo_full>>• Целое фото<br><</if>>\
</div>


:: StoryScript [script]
Macro.add('terminalScreen', {
  handler: function () {
    let box = document.createElement('div');
    box.className = 'terminal-box-animated';
    box.innerHTML = `
      <div style="color: #f1c40f; margin-bottom: 15px;">
        [ЛОКАЛЬНАЯ СЕТЬ // ENFORCERS SECURE TERMINAL v4.12]<br>
        [УСТРОЙСТВО: ЗАКРЫТЫЙ ТЕРМИНАЛ СВЯЗИ]
      </div>
      <hr style="border-color: #1e8449; margin-bottom: 15px;">
      <div style="line-height: 1.6;">
        <b>МЕСТОПОЛОЖЕНИЕ:</b> <b style="color: #e74c3c; letter-spacing: 1px;">[ДАННЫЕ УДАЛЕНЫ // СЕКРЕТНО]</b><br>
        <b>ВРЕМЯ / МЕТКА:</b> <b style="color: #e74c3c; letter-spacing: 1px;">███.███.M41 // СИГНАЛ ПЕРЕХВАЧЕН И ЗАСИФРОВАН</b><br>
        <b>УРОВЕНЬ ДОСТУПА:</b> LEX IMPERIALIS (ALPHA-RESTRICTED)
      </div>
      <p style="margin: 20px 0; color: #a9dfbf; font-style: italic;">
        Инициализация защищенного канала... Расшифровка входящего пакета данных от Divisio Auditae...<br>
        Внимание: Обнаружены аномалии в структуре потока. Ретрансляция ведется из неустановленного сектора.
      </p>
      <hr style="border-color: #1e8449; margin-top: 15px; margin-bottom: 20px;">
      <div style="text-align: center; margin-top: 20px;" class="terminal-link-container"></div>
    `;

    this.output.appendChild(box);

    $(box)
      .find('.terminal-link-container')
      .wiki('<<button "ПРИНЯТЬ И ОТКРЫТЬ ДОСЬЕ АУДИТОРА ВЕРТЫ" "prol_checkstats">><</button>>');
  }
});

Macro.add('auditReport', {
  handler: function () {
    let stats = State.variables.stats;
    let eye = State.variables.eye_injury;
    let lostFingers = State.variables.lost_fingers;
    let hand = State.variables.hand_injury;
    let auditorVerdict = State.variables.auditor_verdict;
    let photoFull = State.variables.has_photo_full;
    let photoBurnt = State.variables.has_photo_burnt;
    let key = State.variables.has_key;

    let injuriesHTML = "";
    if (eye) injuriesHTML += "• <b>Офтальмологический дефект:</b> Потеря левого зрительного органа.<br>";
    if (lostFingers) injuriesHTML += "• <b>Калечащее ранение:</b> Ампутация двух фаланг ведущей руки.<br>";
    if (hand) injuriesHTML += "• <b>Травма опорно-двигательного аппарата:</b> Сквозное повреждение мягких тканей ладоней.<br>";
    if (!eye && !lostFingers && !hand) injuriesHTML += "• Физических увечий и тяжелых травм не зафиксировано.<br>";

    let cluesHTML = "";
    if (photoFull) cluesHTML += "• [ДОПОЛНИТЕЛЬНЫЙ МАТЕРИАЛ] Добыто фотоизображение без цензуры.<br>";
    if (photoBurnt) cluesHTML += "• [ВЕЩДОК] Обгоревший фрагмент фотографии.<br>";
    if (key) cluesHTML += "• [ВЕЩДОК] Металлический ключ неустановленного образца.<br>";
    cluesHTML += "• [ОТЧЁТ О ВСКРЫТИИ] Свидетель «Тройник» ликвидирован. В тканях неопознанного убийцы обнаружены следы незарегистрированного боевого стимулятора.<br>";
    cluesHTML += "• [СТАТУС] Аудитор В. Верта официально включена в оперативно-розыскную группу.<br>";

    let box = document.createElement('div');
    box.className = 'terminal-box-animated';
    box.style.marginBottom = '25px';
    box.innerHTML = `
      <h3 style="margin-top: 0; margin-bottom: 5px; color: #f1c40f; border-bottom: 1px solid #1e8449; padding-bottom: 8px; font-family: monospace;">
        [ИМПЕРСКИЙ АРХИВ // DIVISIO AUDITAE]
      </h3>
      <div style="font-weight: bold; font-size: 0.9em; letter-spacing: 1px; color: #e74c3c; margin-bottom: 15px;">
        СЛУЖЕБНАЯ ЗАПИСКА // ВНУТРЕННИЙ АУДИТ И ОЦЕНКА ПРИГОДНОСТИ
      </div>
      
      <b>Субъект:</b> Марк Витус, следователь Enforcers<br>
      <b>Составитель:</b> Аудитор Валерия Верта (Lex Imperialis / Arbites)<br>
      <b>Основание инспекции:</b> Служебный запрос #77-A/ENF<br>
      <hr style="border-color: #1e8449; margin: 15px 0;">
      
      <b>1. Медицинское освидетельствование и боеспособность:</b><br>
      ${injuriesHTML}<br>

      <b>2. Улики, приобщённые к делу #428/M41:</b><br>
      ${cluesHTML}<br>

      <b>3. Оперативные метрики субъекта:</b><br>
      • <b>Личные качества:</b> Агрессия: ${stats.aggression} | Хладнокровие: ${stats.composure} | Наблюдательность: ${stats.perception} | Влияние: ${stats.influence}<br>
      • <b>Социальный статус:</b> Доверие: ${stats.trust} | Авторитет на улицах: ${stats.respect_street} | Уважение коллег: ${stats.respect_colleagues}<br><br>

      <b>4. Вердикт аудитора:</b><br>
      • ${auditorVerdict}<br><br>
      • <b>Статус:</b> Объект по-прежнему представляет потенциальную опасность.
    `;
    this.output.appendChild(box);

    let btnDiv = document.createElement('div');
    btnDiv.style.textAlign = 'center';
    btnDiv.style.marginTop = '20px';
    
    let btn = document.createElement('a');
    btn.href = "javascript:void(0);";
    btn.innerText = "ПРИНЯТЬ К СВЕДЕНИЮ И ЗАКРЫТЬ";
    btn.style.cssText = "display: inline-block; background-color: #0b1f14; color: #2ecc71; border: 1px solid #2ecc71; padding: 12px 24px; font-family: monospace, sans-serif; font-weight: bold; text-decoration: none; box-shadow: 0 0 10px rgba(46, 204, 113, 0.2); transition: all 0.2s ease; cursor: pointer;";
    
    btn.onmouseover = function() {
      this.style.backgroundColor = '#1e8449';
      this.style.color = '#ffffff';
      this.style.boxShadow = '0 0 15px rgba(46, 204, 113, 0.6)';
    };
    btn.onmouseout = function() {
      this.style.backgroundColor = '#0b1f14';
      this.style.color = '#2ecc71';
      this.style.boxShadow = '0 0 10px rgba(46, 204, 113, 0.2)';
    };

    btn.onclick = function() {
      Engine.play('ch_1_start');
    };

    btnDiv.appendChild(btn);
    this.output.appendChild(btnDiv);
  }
});
Macro.add('tvScreen', {
  handler: function () {
    let args = this.args;
    let broadcastTitle = args[0] || "[ВОКС-КАНАЛ // ГОЛО-ТЕРМИНАЛ]";
    let broadcastText = args[1] || "Трансляция...";
    
    // Передаем пары: [ТекстКнопки1, Цель1, ТекстКнопки2, Цель2]
    let btn1Text = args[2] || "Повернуть влево";
    let btn1Target = args[3] || "prol_sc04_tv1";
    let btn2Text = args[4] || "Повернуть вправо";
    let btn2Target = args[5] || "prol_sc04_tv2";

    let box = document.createElement('div');
    box.className = 'terminal-box-animated';
    box.style.border = '1px solid #e74c3c'; // Атмосферная красная рамка вокс-эфира
    box.style.boxShadow = 'inset 0 0 15px rgba(231, 76, 60, 0.1)';
    box.innerHTML = `
      <div style="color: #e74c3c; margin-bottom: 15px; font-weight: bold; font-family: monospace;">
        ${broadcastTitle}
      </div>
      <hr style="border-color: #e74c3c; margin-bottom: 15px;">
      <div style="line-height: 1.6; color: #f1c40f; font-style: italic; font-family: monospace;">
        ${broadcastText}
      </div>
      <hr style="border-color: #e74c3c; margin-top: 15px; margin-bottom: 20px;">
      <div style="text-align: center; margin-top: 20px; display: flex; justify-content: center; gap: 15px; flex-wrap: wrap;" id="tv-links-container"></div>
    `;
    this.output.appendChild(box);
    
    // Рендерим обе нативные кнопки SugarCube внутри контейнера
    jQuery('#tv-links-container').wiki(`
      <<button "${btn1Text}" "${btn1Target}">><</button>>
      <<button "${btn2Text}" "${btn2Target}">><</button>>
    `);
  }
});

