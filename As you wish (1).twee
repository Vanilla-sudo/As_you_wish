:: StoryData
{
  "ifid": "04DC6195-F6FE-45FC-9954-E2EC056C0FE8",
  "format": "SugarCube",
  "format-version": "2.37.3",
  "start": "prol_sc01_intro",
  "tag-colors": {
    "Информаторы": "red"
  },
  "zoom": 1
}


:: Journal_UI {"position":"4700,25","size":"100,100"}
<style>
  #journal-root a {
    color: #2ecc71 !important;
    text-decoration: none;
  }
  #journal-root a:hover {
    color: #a9dfbf !important;
  }
  .vox-btn-container button {
    background: #002200;
    color: #2ecc71;
    border: 1px solid #2ecc71;
    padding: 6px 12px;
    font-family: monospace;
    font-weight: bold;
    cursor: pointer;
    width: 100%;
    text-align: center;
    transition: background 0.2s, color 0.2s;
  }
  .vox-btn-container button:hover {
    background: #1e8449;
    color: #ffffff;
  }
</style>

<div id="journal-root" style="font-family: monospace; color: #2ecc71; padding: 0px; font-size: 1em; line-height: 1.2;">

<!-- ВЕРХНЯЯ НАВИГАЦИОННАЯ ПАНЕЛЬ -->
<div style="border-bottom: 2px solid #2ecc71; padding-bottom: 4px; margin-bottom: 6px; display: flex; gap: 12px; font-weight: bold; font-size: 0.9em;">
  <<link "[ Контакты ]">>
    <<set _journalTab = "informants">>
    <<set _selectedInformantId = null>>
    <<set _selectedClueId = null>>
    <<set _selectedNoteId = null>>
    <<replace "#journal-root">><<include "Journal_UI">><</replace>>
  <</link>>

  <<link "[ Улики ]">>
    <<set _journalTab = "clues">>
    <<set _selectedInformantId = null>>
    <<set _selectedClueId = null>>
    <<set _selectedNoteId = null>>
    <<replace "#journal-root">><<include "Journal_UI">><</replace>>
  <</link>>

  <<link "[ Заметки ]">>
    <<set _journalTab = "notes">>
    <<set _selectedInformantId = null>>
    <<set _selectedClueId = null>>
    <<set _selectedNoteId = null>>
    <<replace "#journal-root">><<include "Journal_UI">><</replace>>
  <</link>>
</div>

<!-- ================= 1. ВКЛАДКА: КОНТАКТЫ ================= -->
<<if _journalTab eq "informants" or not _journalTab>>

  <<if _selectedInformantId>>
    <<nobr>>
    <<set _inf = $journal.informants.find(i => i.id === _selectedInformantId)>>
    
    <div style="margin-bottom: 6px; margin-top: 0px;">
      <<link "[ < Назад к списку ]">>
        <<set _selectedInformantId = null>>
        <<replace "#journal-root">><<include "Journal_UI">><</replace>>
      <</link>>
    </div>

    <<if _inf>>
    <div style="border: 1px solid #2ecc71; background: rgba(0, 30, 0, 0.4); padding: 8px; font-size: 0.95em;">
      <div style="color: #2ecc71; font-size: 1.15em; font-weight: bold; margin-bottom: 6px;">_inf.name</div>
      
      <div style="margin-bottom: 8px; color: #a9dfbf; border-left: 2px solid #2ecc71; padding-left: 6px;">
        _inf.desc
      </div>

      <div style="color: #2ecc71; font-size: 0.85em; font-weight: bold; border-bottom: 1px dashed #27ae60; padding-bottom: 2px; margin-bottom: 4px;">
        ЗАФИКСИРОВАННЫЕ ФАКТЫ:
      </div>

      <<if _inf.notes and _inf.notes.length gt 0>>
        <<for _n = 0; _n < _inf.notes.length; _n++>>
          <div style="font-size: 0.85em; color: #2ecc71; margin-bottom: 2px;">
            - _inf.notes[_n]
          </div>
        <</for>>
      <<else>>
        <div style="color: #27ae60; font-style: italic; font-size: 0.85em;">Записи отсутствуют.</div>
      <</if>>

      <!-- ИНТЕРАКТИВНЫЙ БЛОК ВОКС-ВЫЗОВА (ЮЛИЙ КРАСС И ВАЛЕРИЯ ВЕРТА) -->
      <<if _inf.id === "krass" or _inf.id === "yuliy" or _inf.name.includes("Юлий")>>
        <div style="margin-top: 12px; border-top: 1px solid #2ecc71; padding-top: 8px;">
          <div style="color: #f1c40f; font-weight: bold; font-size: 0.8em; margin-bottom: 4px;">
            [ ПРЯМАЯ ВОКС-ЛИНИЯ ]
          </div>
          <div class="vox-btn-container">
            <<button " [ ИНИЦИИРОВАТЬ ВОКС-ВЫЗОВ ] ">>
              <<run Dialog.close()>>
              <<if passage() eq "prol_sc06_bar_secur_nosuit">>
                <<goto "prol_sc06_bar_entry_check_trust">>
              <<else>>
                <<goto "VoxCall_Krass_Idle">>
              <</if>>
            <</button>>
          </div>
        </div>

      <<elseif _inf.id === "verta" or _inf.id === "valeria" or _inf.name.includes("Валерия")>>
        <div style="margin-top: 12px; border-top: 1px solid #2ecc71; padding-top: 8px;">
          <div style="color: #f1c40f; font-weight: bold; font-size: 0.8em; margin-bottom: 4px;">
            [ ПРЯМАЯ ВОКС-ЛИНИЯ ]
          </div>
          <div class="vox-btn-container">
            <<button " [ ИНИЦИИРОВАТЬ ВОКС-ВЫЗОВ ] ">>
              <<run Dialog.close()>>
              <<goto "VoxCall_Verta_Idle">>
            <</button>>
          </div>
        </div>
      <</if>>

    </div>
    <</if>>
    <</nobr>>

  <<else>>
    <<nobr>>
    <<set _unlockedCount = 0>>
    <div style="display: flex; flex-direction: column; gap: 2px;">
    <<for _i = 0; _i < $journal.informants.length; _i++>>
      <<if $journal.informants[_i].unlocked>>
        <<set _unlockedCount++>>
        <<capture _i>>
          <div style="border-bottom: 1px dashed #1e8449; padding: 3px 0; margin: 0;">
            <<link "$journal.informants[_i].name">>
              <<set _selectedInformantId = $journal.informants[_i].id>>
              <<replace "#journal-root">><<include "Journal_UI">><</replace>>
            <</link>>
          </div>
        <</capture>>
      <</if>>
    <</for>>
    </div>

    <<if _unlockedCount eq 0>>
      <div style="color: #27ae60; font-style: italic; font-size: 0.9em; text-align: center; margin-top: 5px;">
        База данных пуста.
      </div>
    <</if>>
    <</nobr>>
  <</if>>

<!-- ================= 2. ВКЛАДКА: УЛИКИ ================= -->
<<elseif _journalTab eq "clues">>

  <<if _selectedClueId neq null>>
    <<nobr>>
    <<set _clue = $journal.clues[_selectedClueId]>>
    <<set _clueName = typeof _clue === 'object' ? _clue.name : _clue>>
    <<set _clueDesc = typeof _clue === 'object' ? _clue.desc : "Подробное описание отсутствует.">>
    
    <div style="margin-bottom: 6px; margin-top: 0px;">
      <<link "[ < Назад к списку улик ]">>
        <<set _selectedClueId = null>>
        <<replace "#journal-root">><<include "Journal_UI">><</replace>>
      <</link>>
    </div>

    <div style="border: 1px solid #2ecc71; background: rgba(0, 30, 0, 0.4); padding: 8px; font-size: 0.95em;">
      <div style="color: #2ecc71; font-size: 1.15em; font-weight: bold; margin-bottom: 6px;">_clueName</div>
      
      <div style="color: #a9dfbf; border-left: 2px solid #2ecc71; padding-left: 6px;">
        _clueDesc
      </div>
    </div>
    <</nobr>>

  <<else>>
    <<nobr>>
    <<set _cluesCount = $journal.clues.length>>
    <div style="display: flex; flex-direction: column; gap: 2px;">
    <<for _c = 0; _c < $journal.clues.length; _c++>>
      <<capture _c>>
        <<set _cItem = $journal.clues[_c]>>
        <<set _cName = typeof _cItem === 'object' ? _cItem.name : _cItem>>
        <div style="border-bottom: 1px dashed #1e8449; padding: 3px 0; margin: 0;">
          <<link _cName>>
            <<set _selectedClueId = _c>>
            <<replace "#journal-root">><<include "Journal_UI">><</replace>>
          <</link>>
        </div>
      <</capture>>
    <</for>>
    </div>

    <<if _cluesCount eq 0>>
      <div style="color: #27ae60; font-style: italic; font-size: 0.9em; text-align: center; margin-top: 5px;">
        Улики не зафиксированы.
      </div>
    <</if>>
    <</nobr>>
  <</if>>

<!-- ================= 3. ВКЛАДКА: ЗАМЕТКИ ================= -->
<<elseif _journalTab eq "notes">>

  <<if _selectedNoteId neq null>>
    <<nobr>>
    <<set _note = $journal.notes[_selectedNoteId]>>
    <<set _noteName = typeof _note === 'object' ? _note.name : _note>>
    <<set _noteDesc = typeof _note === 'object' ? _note.desc : "Текст заметки отсутствует.">>
    
    <div style="margin-bottom: 6px; margin-top: 0px;">
      <<link "[ < Назад к списку заметок ]">>
        <<set _selectedNoteId = null>>
        <<replace "#journal-root">><<include "Journal_UI">><</replace>>
      <</link>>
    </div>

    <div style="border: 1px solid #2ecc71; background: rgba(0, 30, 0, 0.4); padding: 8px; font-size: 0.95em;">
      <div style="color: #f1c40f; font-size: 1.15em; font-weight: bold; margin-bottom: 6px;">_noteName</div>
      
      <div style="color: #a9dfbf; border-left: 2px solid #f1c40f; padding-left: 6px; margin-bottom: 10px;">
        <<print _noteDesc>>
      </div>

      <!-- ВЫВОД НАКОПЛЕННЫХ ФАКТОВ ВНУТРИ ЗАМЕТКИ -->
      <<if _note.notes and _note.notes.length gt 0>>
        <div style="color: #2ecc71; font-size: 0.85em; font-weight: bold; border-bottom: 1px dashed #27ae60; padding-bottom: 2px; margin-bottom: 6px;">
          ЗАФИКСИРОВАННЫЕ ФАКТЫ:
        </div>
        <<for _i = 0; _i < _note.notes.length; _i++>>
          <div style="font-size: 0.85em; color: #2ecc71; margin-bottom: 4px;">
            • _note.notes[_i]
          </div>
        <</for>>
      <</if>>

    </div>
    <</nobr>>

  <<else>>
    <<nobr>>
    <<set _notesCount = $journal.notes.length>>
    <div style="display: flex; flex-direction: column; gap: 2px;">
    <<for _n = 0; _n < $journal.notes.length; _n++>>
      <<capture _n>>
        <<set _nItem = $journal.notes[_n]>>
        <<set _nName = typeof _nItem === 'object' ? _nItem.name : _nItem>>
        <div style="border-bottom: 1px dashed #1e8449; padding: 3px 0; margin: 0;">
          <<link _nName>>
            <<set _selectedNoteId = _n>>
            <<replace "#journal-root">><<include "Journal_UI">><</replace>>
          <</link>>
        </div>
      <</capture>>
    <</for>>
    </div>

    <<if _notesCount eq 0>>
      <div style="color: #27ae60; font-style: italic; font-size: 0.9em; text-align: center; margin-top: 5px;">
        Заметки отсутствуют.
      </div>
    <</if>>
    <</nobr>>
  <</if>>

<</if>>

</div>


:: Journal_VoxCall_Krass {"position":"4850,25","size":"100,100"}
<<nobr>>
<style>
  .vox-terminal {
    border: 2px solid #2ecc71;
    background: rgba(0, 20, 0, 0.85);
    padding: 20px;
    font-family: monospace;
    color: #2ecc71;
    border-radius: 6px;
    box-shadow: 0 0 15px rgba(46, 204, 113, 0.25);
    width: 90%;
    max-width: 850px;
    margin: 20px auto;
    box-sizing: border-box;
  }
  .vox-status {
    border-bottom: 1px dashed #2ecc71;
    padding-bottom: 8px;
    margin-bottom: 14px;
    font-size: 0.95em;
    color: #f1c40f;
  }
  .vox-line {
    margin-bottom: 12px;
    line-height: 1.4;
    font-size: 1.1em;
  }
  .vox-speaker-you {
    color: #f1c40f;
    font-weight: bold;
  }
  .vox-speaker-prefect {
    color: #a9dfbf;
    font-weight: bold;
  }
</style>

<div class="vox-terminal">
  <div class="vox-status">
    [ ВОКС-КАНАЛ: ПРЕФЕКТУРА / СОЕДИНЕНИЕ УСТАНОВЛЕНО ]<br>
    <span style="color: #888; font-style: italic;">*Шипение статики и щелчки вокс-шифрования...*</span>
  </div>

  /* Проверяем previous(), то есть пассаж, из которого был совершен вызов */
  <<if previous() eq "prol_sc06_bar_entry_check_trust">>

    <<if $trust >= 1>>
      <!-- Ветвь высокого доверия -->
      <div class="vox-line"><span class="vox-speaker-you">[ ВЫ ]:</span> — Юлий, мне срочно понадобилась твоя Санкция Магистрата.</div>
      <div class="vox-line"><span class="vox-speaker-prefect">[ ЮЛИЙ ]:</span> — Санкция, зачем? Ты понимаешь, что сейчас ночь, давай на завтра отложим.</div>
      <div class="vox-line"><span class="vox-speaker-you">[ ВЫ ]:</span> — Тебе ведь нужна раскрываемость? Может, не будешь палки в колёса ставить?</div>
      <div class="vox-line"><span class="vox-speaker-prefect">[ ЮЛИЙ ]:</span> — Похоже, у меня нет выбора. Сейчас составлю и всё направлю.</div>

      <div style="margin-top: 18px; border-top: 1px dashed #2ecc71; padding-top: 12px; font-size: 1.1em;">
        [[Идти в бар|prol_sc06_bar_order]]
      </div>

    <<else>>
      <!-- Ветвь низкого доверия -->
      <div class="vox-line"><span class="vox-speaker-prefect">[ ЮЛИЙ ]:</span> — Санкция, говоришь? Мало того, что звонишь среди ночи, так ещё и наглости хватает просить о таком после того, что ты сделал?</div>
      <div class="vox-line"><span class="vox-speaker-you">[ ВЫ ]:</span> — Это чего я такого сделал?</div>
      <div class="vox-line"><span class="vox-speaker-prefect">[ ЮЛИЙ ]:</span> — Тебе напомнить? Мальчик-преступник, аудитор, допрос. Продолжать?</div>
      <div class="vox-line"><span class="vox-speaker-you">[ ВЫ ]:</span> — Да он всего лишь мальчишка, да и информатором может стать!</div>
      <div class="vox-line"><span class="vox-speaker-prefect">[ ЮЛИЙ ]:</span> — Ты подставил меня перед аудитором! Знаешь, сколько мне пришлось объясняться перед начальством? Думал, она не доложит о твоих нарушениях?</div>
      <div class="vox-line"><span class="vox-speaker-you">[ ВЫ ]:</span> — Так и как мне вести расследование, если у меня нет ордера?</div>
      <div class="vox-line"><span class="vox-speaker-prefect">[ ЮЛИЙ ]:</span> — Придумай что-нибудь. Ты же у нас опытный детектив!</div>

      <div style="color: #e74c3c; margin: 14px 0; font-style: italic; font-size: 0.95em;">
        *Абонент принудительно разорвал вокс-соединение...*
      </div>

      <div style="color: #a9dfbf; font-style: italic; font-size: 1em; margin-top: 10px; border-top: 1px solid rgba(46,204,113,0.3); padding-top: 10px;">
        //Эта крыса пожаловалась! Ей так хотелось отправить сопляка на казнь?//<br><br>
        //Меня окружают одни стукачи и лентяи. Делать нечего, нужно искать другой вход. Левой рукой я потянулся в карман за куревом.//
      </div>

      <div style="margin-top: 18px; border-top: 1px dashed #2ecc71; padding-top: 12px; font-size: 1.1em;">
        [[Закурить и подумать|prol_sc06_bar_lurk]]
      </div>
    <</if>>

  <<else>>

    <!-- Реплика для любого другого пассажа -->
    <div class="vox-line"><span class="vox-speaker-prefect">[ ЮЛИЙ ]:</span> — Что опять? У меня нет времени на твои пустяковые расспросы. Не беспокой меня по мелочам! Докладывай только при наличии реальных зафиксированных улик.</div>

    <div style="color: #e74c3c; margin: 14px 0; font-style: italic; font-size: 0.95em;">
      *Префект сбросил вокс-соединение...*
    </div>

    <div style="margin-top: 18px; border-top: 1px dashed #2ecc71; padding-top: 12px; font-size: 1.1em;">
      <<link "[ Убрать планшет ]">>
        <<return>>
      <</link>>
    </div>

  <</if>>
</div>
<</nobr>>


:: StoryCaption {"position":"4550,25","size":"100,100"}
/* 1. КНОПКА ОТКРЫТИЯ ИНФОПЛАНШЕТА */
<<if $has_holopad>>
  <div style="margin-bottom: 15px;">
    <div class="red-terminal-btn">
      <<button " Инфопланшет ">>
        /* 1. Очищаем текст диалога и мыслей на текущей странице */
        <<run jQuery('#story-text').empty()>>

        /* 2. Открываем диалоговое окно Дневника */
        <<run Dialog.setup("ИНФОПЛАНШЕТ ENFORCER-HRXZ/8856945")>>
        <<set _journalTab = "informants">>
        <<set _selectedInformantId = null>>
        <<run Dialog.wiki('<<include "Journal_UI">>')>>
        <<run Dialog.open()>>

        /* 3. Обновляем список контактов ТОЛЬКО ЕСЛИ мы на странице хаба (где есть #contacts) */
        <<if jQuery("#contacts").length gt 0>>
          <<replace "#contacts">>
            <div style="margin-top: 10px;">
              //Осталось выбрать, кого навестить первым...//<br><br>
              [[Аластор|prol_sc05_Alastor]] <br>
              [[Виктор|prol_sc05_Victor]] <br>
              [[Исраэль|prol_sc05_Israel]] <br>
              [[Ордо|prol_sc05_Ordo]] <br>
            </div>
          <</replace>>
        <</if>>
      <</button>>
    </div>
  </div>
<</if>>

/* 2. БЛОК ХАРАКТЕРИСТИК И ИНВЕНТАРЯ */
<div class="stats-panel" style="margin-top: 0px; padding-top: 5px;">
  <div class="stats-header" style="margin-top: 0px;"> ХАРАКТЕРИСТИКИ</div>
  Агрессия: $stats.aggression<br>
  Хладнокровие: $stats.composure<br>
  Влияние: $stats.influence<br>
  Наблюдательность: $stats.perception<br>


  <div class="stats-header"> РЕПУТАЦИЯ</div>
  Улица: $stats.respect_street | Коллеги: $stats.respect_colleagues<br>
  Доверие: $stats.trust<br>

  <div class="stats-header"> ИНВЕНТАРЬ</div>
  Деньги: $money<br>
  <<if $has_wallet>>• Кошелёк<br><</if>>\
  <<if $has_suit>>• Костюм<br><</if>>\
  <<if $has_pass>>• Пропуск<br><</if>>\
  <<if $has_vip_pass>>• VIP-пропуск<br><</if>>\
  <<if $has_key>>• Ключ<br><</if>>\
  <<if $has_capsules>>• Капсулы<br><</if>>\
  <<if $has_photo_burnt>>• Обгоревшее фото<br><</if>>\
  <<if $has_photo_full>>• Целое фото<br><</if>>\
</div>


:: StoryInit {"position":"4400,25","size":"100,100"}
/* Инициализация скрытых характеристик персонажа */
<<set $stats to {
  aggression: 0,
  composure: 0,
  influence: 0,
  perception: 0,
  corruption: 0,
  respect_street: 0,
  respect_colleagues: 0,
  trust: 0
}>>

/* Инициализация инвентаря и предметов */
<<set $money to 0>>          /* Наличные деньги в кошельке/при себе */
<<set $home_money to 5000>> /* Заначка/деньги дома в тайнике */
<<set $has_wallet to false>>
<<set $has_pass to false>>
<<set $has_vip_pass to false>>
<<set $has_suit to false>>
<<set $has_photo_burnt to false>>
<<set $has_photo_full to false>>
<<set $has_key to false>>
<<set $has_capsules to false>>
<<set $has_holopad to false>>

/* Физическое состояние, ранения и аугментации */
<<set $was_beaten to false>>
<<set $was_poisoned to false>>
<<set $lost_fingers to false>>          /* Флаг потери пальцев */
<<set $can_augment_hand to false>>      /* Доступность кибер-протезирования руки */
<<set $has_hand_augmentation to false>> /* Флаг: установлена ли аугментация */

/* Флаги сюжетных знаний, подозрения и диалогов */
<<set $waiter_name_known to false>> /* Узнал имя официанта (Виктора) */
<<set $guard_suspicious to false>>  /* Подозрение охранника на кухне */
<<set $velina_suspicious to false>> /* Подозрение Велины */
<<set $velina_known to false>>
<<set $talked_guards to false>>

/* Флаги разговоров в баре */
<<set $talked_cassandra to false>>
<<set $talked_cressida to false>>
<<set $talked_velina to false>>

/* Полезные контакты и связи */
<<set $cassandra_contact to false>>
<<set $cressida_contact to false>>

/* Флаги исследования локаций */
<<set $searched_closet to false>>
<<set $searched_bed to false>>

/* Состояние Исраэля ("unknown", "alive", "dead") */
<<set $israel_status to "unknown">>

/* Состояния меток / зацепок / улик */
<<set $clues to {
  troubled_neighbor: false,
  red_dress: false,
  bar_info: false,
  clue_1: false,
  clue_2: false,
  clue_3: false,
  clue_4: false,
  israel_dead: false,
  israel_helped: false,
  hotel_code: false
}>>

